# ------------------------------------------------------------
# PSI Field Lab — Environment Configuration (TEMPLATE)
# Paranormal 3:33 Research Lab
# ------------------------------------------------------------
#
# HOW TO USE
#   1. Copy this file to `paranormal/.env`:
#          cp paranormal/.env.example paranormal/.env
#   2. Fill in only the values you need. Every value below is a safe
#      placeholder; the defaults run the notebook fully offline
#      (local CSV files + deterministic mock LLM).
#   3. NEVER commit `paranormal/.env`. It is listed in .gitignore.
#
# The notebook loads this file from /work/paranormal/.env (Deepnote layout).
# For local execution see "Running locally" in the README.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

# Free-text label printed at start-up (deepnote | local | colab).
ENVIRONMENT=deepnote

# Folder containing sessions.csv, sensor_windows.csv, events.csv,
# audio_reviews.csv and ground_truth.csv.
#   Deepnote: /work/paranormal
#   Local:    ./paranormal   (or an absolute path)
PSI_DATA_DIR=/work/paranormal

# Root folder for run outputs. Each execution writes to
# <PSI_OUTPUT_DIR>/output_<YYYYMMDD_HHMMSS>_UTC/
PSI_OUTPUT_DIR=/tmp/psi_lab_v3_outputs

# Folder where the final ZIP package of each run is copied.
PSI_DOWNLOAD_DIR=/work/psi_lab_v3_downloads

# ------------------------------------------------------------
# LLM reviewer (Ollama-compatible endpoint)
# ------------------------------------------------------------

# auto | live | mock
#   auto : try the endpoint, fall back to the labelled mock if it fails
#   live : require a working endpoint (hard error otherwise)
#   mock : never call a model; deterministic heuristic stand-in
PSI_LLM_MODE=auto

# Remote Ollama API (the reference run used https://api.ollama.com) or a
# local server (e.g. http://localhost:11434). Leave the key empty for a local server.
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=gemma4:latest
OLLAMA_API_KEY=your-ollama-api-key-here

# LLM execution settings
LLM_TEMPERATURE=0
# Number of repeated calls per event (majority vote + self-agreement metric)
LLM_REVIEW_REPEATS=3
# Events per request in the blind batch cross-check
LLM_BATCH_SIZE=10
# Number of top-ranked events reviewed (plus the same number of random lower-ranked controls)
PSI_LLM_TOP_N=20
# Salt used to hash site/participant IDs in blind records
PSI_BLIND_SALT=psi-333

# Informational flags recorded for audit (current notebook always performs these steps)
LLM_SAVE_RAW_RESPONSE=true
LLM_VALIDATE_JSON=true

# ------------------------------------------------------------
# PostgreSQL / Neon (OPTIONAL — leave USE_POSTGRES=false to use CSV files)
# ------------------------------------------------------------

USE_POSTGRES=false

POSTGRES_HOST=your-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_SSLMODE=require
POSTGRES_CHANNEL_BINDING=require
POSTGRES_SCHEMA=psi_lab

# SQLAlchemy connection string (the only DB variable the notebook actually reads)
DATABASE_URL=postgresql+psycopg2://your_user:your_password@your-host.example.com:5432/your_database?sslmode=require&channel_binding=require

# Database behavior
DB_WRITE_MODE=append
DB_ECHO=false

# Persist derived results (feature_scores, llm_reviews, pipeline_runs) to Postgres
WRITE_ANALYSIS_RESULTS_TO_POSTGRES=false
RESULTS_DB_WRITE_MODE=replace

# ------------------------------------------------------------
# Pipeline metadata (written to pipeline_run_metadata.json)
# ------------------------------------------------------------

PIPELINE_NAME=psi_field_lab_v3
PIPELINE_VERSION=0.1.0
PROMPT_VERSION=psi_llm_review_v1
DATASET_VERSION=synthetic_v2_seed_333
SEED=333

# ------------------------------------------------------------
# Table names (PostgreSQL mode)
# ------------------------------------------------------------

TABLE_SESSIONS=sessions
TABLE_SENSOR_WINDOWS=sensor_windows
TABLE_EVENTS=events
TABLE_AUDIO_REVIEWS=audio_reviews
TABLE_GROUND_TRUTH=ground_truth
TABLE_FEATURE_SCORES=feature_scores
TABLE_LLM_REVIEWS=llm_reviews
TABLE_PIPELINE_RUNS=pipeline_runs

# ------------------------------------------------------------
# Audit / Review settings (informational; recorded for governance)
# ------------------------------------------------------------

STORE_RAW_LLM_JSON=true
STORE_PROMPT_TEXT=true
STORE_RECORD_HASH=true
STORE_RESPONSE_HASH=true
CHECK_INVENTED_NUMBERS=true
HUMAN_REVIEW_REQUIRED=true

# ------------------------------------------------------------
# Demo / Presentation mode (informational)
# ------------------------------------------------------------

DEMO_MODE=true
DEMO_AUDIENCE=psi_lab_demo
DEMO_LABEL=PSI Field Lab v0.1 Operational Demo
